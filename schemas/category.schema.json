{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tools-directory.local/schemas/category.schema.json",
  "title": "Categories",
  "description": "Schema definition for directory categories",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "slug",
      "name",
      "shortDescription",
      "description",
      "icon",
      "subcategories"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      },
      "shortDescription": {
        "type": "string",
        "minLength": 10,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "minLength": 20,
        "maxLength": 1000
      },
      "icon": {
        "type": "string",
        "description": "Material Icons icon name or SVG token"
      },
      "subcategories": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name", "slug"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "slug": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      },
      "featured": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
