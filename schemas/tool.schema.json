{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tools-directory.local/schemas/tool.schema.json",
  "title": "AITool",
  "description": "Schema definition for an AI tool entry in the AI Tools Directory",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "shortDescription",
    "description",
    "categories",
    "websiteUrl",
    "pricing",
    "platforms",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique immutable identifier, lowercase alphanumeric with single hyphens"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Display name of the tool"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL-friendly slug, typically identical to id"
    },
    "shortDescription": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220,
      "description": "Concise factual summary for card displays and meta descriptions"
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 3000,
      "description": "Detailed factual description of the tool, core technology, and capabilities"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "List of category slugs this tool belongs to. First element is primary category."
    },
    "subcategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional subcategory identifiers"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Search and classification tags"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Official website URL"
    },
    "pricing": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "free",
            "freemium",
            "paid",
            "open-source",
            "free-trial",
            "contact-for-pricing"
          ]
        },
        "details": {
          "type": ["string", "null"],
          "description": "Brief description of free tier limits or starting price"
        },
        "lastVerifiedAt": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "web",
          "android",
          "ios",
          "windows",
          "macos",
          "linux",
          "api",
          "browser-extension"
        ]
      }
    },
    "isOpenSource": {
      "type": ["boolean", "null"],
      "description": "True if source code is publicly accessible under OSI-approved license. Null if unverified."
    },
    "sourceCodeUrl": {
      "type": ["string", "null"],
      "description": "URL to repository (e.g., GitHub) if open source"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"],
      "description": "Publication lifecycle state"
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of key features"
    },
    "useCases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Recommended practical use cases"
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tool IDs of direct alternative tools"
    },
    "relatedTools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tool IDs of related or complementary tools"
    },
    "languageSupport": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Supported languages or 'multilingual'"
    },
    "accountRequired": {
      "type": ["boolean", "null"],
      "description": "Whether an account is required to use the service"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known factual limitations (e.g. rate limits, region availability)"
    },
    "lastVerifiedAt": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date when the record facts were last verified by an editor"
    },
    "sourceReferences": {
      "type": "array",
      "items": { "type": "string" },
      "description": "URLs or references used to verify facts"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
