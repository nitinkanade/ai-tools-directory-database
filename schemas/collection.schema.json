{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tools-directory.local/schemas/collection.schema.json",
  "title": "Collections",
  "description": "Schema definition for curated tool collections",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "slug",
      "title",
      "description",
      "curatorNotes",
      "toolIds"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "curatorNotes": {
        "type": "string",
        "minLength": 10,
        "maxLength": 1000
      },
      "icon": {
        "type": "string"
      },
      "toolIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "featured": {
        "type": "boolean",
        "default": false
      },
      "updatedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
